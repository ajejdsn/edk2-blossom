/** @file Generic Timer Description Table (GTDT) **/

#include "ArmPlatform.h"
#include <Library/AcpiLib.h>
#include <Library/PcdLib.h>
#include <IndustryStandard/Acpi.h>

#define GTDT_TIMER_FLAGS  0
#define MTK_WATCHDOG_COUNT  FixedPcdGet32 (PcdWatchdogCount)

#pragma pack (1)
typedef struct {
  EFI_ACPI_5_1_GENERIC_TIMER_DESCRIPTION_TABLE Gtdt;
#if (MTK_WATCHDOG_COUNT != 0)
  EFI_ACPI_5_1_GTDT_SBSA_GENERIC_WATCHDOG_STRUCTURE Watchdogs[MTK_WATCHDOG_COUNT];
#endif
} MTK_GENERIC_TIMER_DESCRIPTION_TABLE;
#pragma pack ()

MTK_GENERIC_TIMER_DESCRIPTION_TABLE Gtdt = {
  {
    ARM_ACPI_HEADER (
      EFI_ACPI_5_1_GENERIC_TIMER_DESCRIPTION_TABLE_SIGNATURE,
      MTK_GENERIC_TIMER_DESCRIPTION_TABLE,
      EFI_ACPI_5_1_GENERIC_TIMER_DESCRIPTION_TABLE_REVISION
    ),
    0xFFFFFFFFFFFFFFFFULL,
    0,
    FixedPcdGet32 (PcdArmArchTimerSecIntrNum),
    GTDT_TIMER_FLAGS,
    FixedPcdGet32 (PcdArmArchTimerIntrNum),
    GTDT_TIMER_FLAGS,
    FixedPcdGet32 (PcdArmArchTimerVirtIntrNum),
    GTDT_TIMER_FLAGS,
    FixedPcdGet32 (PcdArmArchTimerHypIntrNum),
    GTDT_TIMER_FLAGS,
    0xFFFFFFFFFFFFFFFFULL,
    MTK_WATCHDOG_COUNT,
#if (MTK_WATCHDOG_COUNT != 0)
    sizeof (EFI_ACPI_5_1_GENERIC_TIMER_DESCRIPTION_TABLE)
#else
    0
#endif
  }
};

VOID* CONST ReferenceAcpiTable = &Gtdt;
