/** @file Multiple APIC Description Table (MADT) **/

#include "ArmPlatform.h"
#include <Library/AcpiLib.h>
#include <Library/ArmLib.h>
#include <Library/PcdLib.h>
#include <IndustryStandard/Acpi.h>

#pragma pack (1)
typedef struct {
  EFI_ACPI_5_0_MULTIPLE_APIC_DESCRIPTION_TABLE_HEADER Header;
  /* Keep the table size independent of the platform's core-count PCD. */
  EFI_ACPI_5_1_GIC_STRUCTURE GicInterfaces[8];
  EFI_ACPI_5_1_GIC_DISTRIBUTOR_STRUCTURE GicDistributor;
  EFI_ACPI_6_1_GICR_STRUCTURE Gicr;
} MTK_MULTIPLE_APIC_DESCRIPTION_TABLE;
#pragma pack ()

MTK_MULTIPLE_APIC_DESCRIPTION_TABLE Madt = {
  {
    ARM_ACPI_HEADER (
      EFI_ACPI_5_0_MULTIPLE_APIC_DESCRIPTION_TABLE_SIGNATURE,
      MTK_MULTIPLE_APIC_DESCRIPTION_TABLE,
      EFI_ACPI_5_0_MULTIPLE_APIC_DESCRIPTION_TABLE_REVISION
    ),
    0,
    0
  },
  {
    EFI_ACPI_5_1_GICC_STRUCTURE_INIT (0, 0, GET_MPID (0, 0), EFI_ACPI_5_0_GIC_ENABLED, 0, FixedPcdGet64 (PcdGicInterruptInterfaceBase), 0, 0, 0, 0),
    EFI_ACPI_5_1_GICC_STRUCTURE_INIT (1, 1, GET_MPID (0, 1), EFI_ACPI_5_0_GIC_ENABLED, 0, FixedPcdGet64 (PcdGicInterruptInterfaceBase), 0, 0, 0, 0),
    EFI_ACPI_5_1_GICC_STRUCTURE_INIT (2, 2, GET_MPID (0, 2), EFI_ACPI_5_0_GIC_ENABLED, 0, FixedPcdGet64 (PcdGicInterruptInterfaceBase), 0, 0, 0, 0),
    EFI_ACPI_5_1_GICC_STRUCTURE_INIT (3, 3, GET_MPID (0, 3), EFI_ACPI_5_0_GIC_ENABLED, 0, FixedPcdGet64 (PcdGicInterruptInterfaceBase), 0, 0, 0, 0),
    EFI_ACPI_5_1_GICC_STRUCTURE_INIT (4, 4, GET_MPID (1, 0), EFI_ACPI_5_0_GIC_ENABLED, 0, FixedPcdGet64 (PcdGicInterruptInterfaceBase), 0, 0, 0, 0),
    EFI_ACPI_5_1_GICC_STRUCTURE_INIT (5, 5, GET_MPID (1, 1), EFI_ACPI_5_0_GIC_ENABLED, 0, FixedPcdGet64 (PcdGicInterruptInterfaceBase), 0, 0, 0, 0),
    EFI_ACPI_5_1_GICC_STRUCTURE_INIT (6, 6, GET_MPID (1, 2), EFI_ACPI_5_0_GIC_ENABLED, 0, FixedPcdGet64 (PcdGicInterruptInterfaceBase), 0, 0, 0, 0),
    EFI_ACPI_5_1_GICC_STRUCTURE_INIT (7, 7, GET_MPID (1, 3), EFI_ACPI_5_0_GIC_ENABLED, 0, FixedPcdGet64 (PcdGicInterruptInterfaceBase), 0, 0, 0, 0)
  },
  EFI_ACPI_6_0_GIC_DISTRIBUTOR_INIT (
    0, FixedPcdGet64 (PcdGicDistributorBase), 0, 3
  ),
  {
    EFI_ACPI_6_1_GICR,
    sizeof (EFI_ACPI_6_1_GICR_STRUCTURE),
    EFI_ACPI_RESERVED_WORD,
    FixedPcdGet64 (PcdGicRedistributorsBase),
    0x00200000
  }
};

VOID* CONST ReferenceAcpiTable = &Madt;
